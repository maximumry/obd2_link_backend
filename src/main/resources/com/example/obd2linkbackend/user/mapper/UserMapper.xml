<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.obd2linkbackend.user.mapper.UserMapper">

    <!-- 1件取得 -->
    <select id="getUser" resultType="com.example.obd2linkbackend.user.model.entity.User">
        SELECT
            id
            , email
            , display_name AS displayName
            , created_at AS createdAt
        FROM users
        WHERE id = #{id}
    </select>

    <!-- ユーザー登録　-->
    <insert id="registerUser" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO
            users (
                email
                , display_name
            )
            VALUES (
                #{email}
                , #{displayName}
            )
    </insert>

</mapper>